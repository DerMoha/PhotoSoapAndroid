# Optional aggregate community metrics configuration.
metrics.url=https://YOUR_PROJECT.supabase.co/functions/v1/metrics-ingest
metrics.anonKey=YOUR_SUPABASE_PUBLISHABLE_KEY

# Release signing is intentionally kept outside source control.
signing.storeFile=/absolute/path/to/release.keystore
signing.storePassword=YOUR_STORE_PASSWORD
signing.keyAlias=YOUR_KEY_ALIAS
signing.keyPassword=YOUR_KEY_PASSWORD
