    <!-- Privacy policy -->
    <string name="privacy_last_updated">Last updated: July 29, 2026</string>
    <string name="privacy_intro_title">Privacy by design</string>
    <string name="privacy_intro_body">PhotoSoap helps you review your photo library on your device. It is designed not to collect or upload photo or video contents.</string>
    <string name="privacy_library_title">Photo library access</string>
    <string name="privacy_library_body">PhotoSoap uses Android media permissions so you can review photos and videos and choose items to delete. Photo and video contents stay on your device. PhotoSoap does not send contents, filenames, media identifiers, locations, or album contents to its metrics service. Android asks for your approval before PhotoSoap deletes protected media.</string>
    <string name="privacy_device_title">Data stored on your device</string>
    <string name="privacy_device_body">PhotoSoap stores preferences and review progress locally, including reviewed-item state, the delete list, statistics, streaks, goals, and achievements. This data operates the app and is not used for cross-app tracking.</string>
    <string name="privacy_analytics_title">Optional usage analytics</string>
    <string name="privacy_analytics_body">Analytics are off unless you choose to share them. If enabled, PhotoSoap may send a random installation identifier, app version and build, platform, submission date, and daily totals for items reviewed, kept, deleted, and estimated bytes freed to a backend powered by Supabase. It never includes media contents, filenames, media identifiers, locations, contacts, or advertising identifiers. Turning analytics off stops collection, clears pending metrics, and removes the local analytics identifier. Previously submitted aggregate metrics may remain in community totals.</string>
    <string name="privacy_tracking_title">Tracking and advertising</string>
    <string name="privacy_tracking_body">PhotoSoap does not track you across apps or websites and does not use data for advertising.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_body">For privacy or support questions, email photosoap@brokenmoha.de.</string>

